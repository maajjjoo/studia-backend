# Configuración del servidor studia-backend
# Copia este archivo a `.env` para desarrollo local (nunca subas `.env` a Git).

# Puerto HTTP del servidor
PORT=3000

# Clave privada de Google AI Studio (obligatoria para responder consultas de IA)
GEMINI_API_KEY=

# Modelo de Gemini a utilizar (por defecto: gemini-3.5-flash-lite)
# Si el modelo cambia de disponibilidad en el futuro, puede cambiarse por ej. a gemini-2.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Tiempo máximo de espera hacia Gemini API en milisegundos (por defecto: 20000)
GEMINI_TIMEOUT_MS=20000

# Límites de protección contra abuso y consumo excesivo de cuota
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=15
GLOBAL_RATE_LIMIT_MAX_REQUESTS=60
MAX_BODY_BYTES=65536

# Orígenes permitidos para CORS (separados por coma, o * para clientes de escritorio Tauri)
CORS_ORIGIN=*
